class Solution {
public:
    vector<int> findAnagrams(string s, string p) {
        vector<int>Pfreq(26,0);
        vector<int>Sfreq(26,0);
        int k=p.size();
        int n=s.size();
   vector<int>ans;
        if(n<k) return ans;

     

        for(char x:p){
            Pfreq[x-'a']++;
        }
        for(int i=0;i<n;i++){
            Sfreq[s[i]-'a']++;
               if(i>=k){
                Sfreq[s[i-k]-'a']--;
            }
            
            if(i>=k-1){
            if(Pfreq==Sfreq){
                ans.push_back(i-k+1);

            }
            }
         
        }
        return ans;
    }
};
