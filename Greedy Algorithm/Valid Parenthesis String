class Solution {
public:
    bool checkValidString(string s) {
        //left to right
        int count=0;
        for(int i=0;i<s.size();i++){
            if(s[i]=='(' || s[i]=='*') count++;
            else count--;

            if(count<0) return false;
        }
        


         // right to left
      count=0;
        for(int i=s.size()-1;i>=0;i--){
            if(s[i]==')' || s[i]=='*') count++;
            else count--;

            if(count<0) return false;
        }
        return true;
    }
};
